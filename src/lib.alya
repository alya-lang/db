## db Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Driver-agnostic database facade: callers hold a `Driver` value (built by
## a driver package or by hand, see `tests/test_basic.alya` for a complete
## mock) and run every operation through it. No driver registry, no globals:
## adding a driver means constructing one more `Driver`, never editing this
## package.

import "./types.alya"

# ───────────────────────────────────────────────────────────────
# Connections
# ───────────────────────────────────────────────────────────────

## Opens a connection through a driver.
##
## ### Parameters
## - `driver`: Target `Driver` (its `open_fn` hook runs).
## - `path`: Connection target string (file path, URL, `:memory:` ...).
##
## ### Returns
## An open `Conn` handle.
##
## ### Examples
## ```alya
## let conn = open(driver, ":memory:")
## ```
pub function open(driver: Driver, path: string) -> Conn
    let open_fn = driver.open_fn
    let handle = open_fn(path)
    return Conn { driver: driver, handle: handle, path: path, is_open: true }
end

## Closes a connection; closing twice safely returns `0`.
##
## ### Parameters
## - `conn`: Target `Conn` handle.
##
## ### Returns
## Driver close result code integer.
pub function close(conn: Conn) -> int
    if conn.is_open != true
        return 0
    end
    let close_fn = conn.driver.close_fn
    let rc = close_fn(conn.handle)
    conn.is_open = false
    return rc
end

# ───────────────────────────────────────────────────────────────
# Query and Command Execution
# ───────────────────────────────────────────────────────────────

## Executes a statement with bound `?` parameters.
##
## ### Parameters
## - `conn`: Target `Conn` handle.
## - `sql`: SQL statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## Affected row count integer.
##
## ### Examples
## ```alya
## execute(conn, "INSERT INTO kv (k, v) VALUES (?, ?);", [param_text("a"), param_int(1)])
## ```
pub function execute(conn: Conn, sql: string, params: array = []) -> int
    if conn.is_open != true
        throw db_error(1, "Cannot execute on closed connection")
    end
    let execute_fn = conn.driver.execute_fn
    return execute_fn(conn.handle, sql, params)
end

## Runs a SELECT query with bound `?` parameters.
##
## Rows decode to column-name maps; value dynamics follow the driver
## (ints, floats, strings, nulls, byte arrays).
##
## ### Parameters
## - `conn`: Target `Conn` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## Array of row maps (possibly empty).
pub function query(conn: Conn, sql: string, params: array = []) -> array
    if conn.is_open != true
        throw db_error(1, "Cannot query on closed connection")
    end
    let query_fn = conn.driver.query_fn
    return query_fn(conn.handle, sql, params)
end

## Returns the first column of the first row, or null when no rows match.
##
## ### Parameters
## - `conn`: Target `Conn` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## The scalar value, or null for empty results.
pub function query_scalar(conn: Conn, sql: string, params: array = [])
    let rows = query(conn, sql, params)
    if len(rows) == 0
        return null
    end
    let first_row = rows[0]
    let ks = keys(first_row)
    for k in ks
        return first_row[k]
    end
    return null
end

## Begins a transaction (`BEGIN` through the driver).
##
## ### Parameters
## - `conn`: Target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function begin(conn: Conn) -> int
    return execute(conn, "BEGIN")
end

## Commits the current transaction (`COMMIT` through the driver).
##
## ### Parameters
## - `conn`: Target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function commit(conn: Conn) -> int
    return execute(conn, "COMMIT")
end

## Rolls back the current transaction (`ROLLBACK` through the driver).
##
## ### Parameters
## - `conn`: Target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function rollback(conn: Conn) -> int
    return execute(conn, "ROLLBACK")
end

# ───────────────────────────────────────────────────────────────
# Connection Struct Methods
# ───────────────────────────────────────────────────────────────

## Executes a statement with bound `?` parameters on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
## - `sql`: SQL statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## Affected row count integer.
pub function Conn.execute(self: Conn, sql: string, params: array = []) -> int
    return execute(self, sql, params)
end

## Runs a SELECT query with bound `?` parameters on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## Array of row maps (possibly empty).
pub function Conn.query(self: Conn, sql: string, params: array = []) -> array
    return query(self, sql, params)
end

## Returns the first column of the first row, or null when no rows match.
##
## ### Parameters
## - `self`: The target `Conn` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## The scalar value, or null for empty results.
pub function Conn.query_scalar(self: Conn, sql: string, params: array = [])
    return query_scalar(self, sql, params)
end

## Begins a transaction on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function Conn.begin(self: Conn) -> int
    return begin(self)
end

## Commits the current transaction on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function Conn.commit(self: Conn) -> int
    return commit(self)
end

## Rolls back the current transaction on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function Conn.rollback(self: Conn) -> int
    return rollback(self)
end

## Closes this connection; closing twice safely returns `0`.
##
## ### Parameters
## - `self`: The target `Conn` handle.
##
## ### Returns
## Driver close result code integer.
pub function Conn.close(self: Conn) -> int
    return close(self)
end
