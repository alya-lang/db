## db Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Driver-agnostic database facade: callers hold a `Driver` value (built by
## a driver package or by hand, see `tests/test_basic.alya` for a complete
## mock) and run every operation through it. No driver registry, no globals:
## adding a driver means constructing one more `Driver`, never editing this
## package.

import "./types.alya"
@cfg(feature = "sqlite")
import "./adapters/sqlite_adapter.alya"

# ───────────────────────────────────────────────────────────────
# Connections
# ───────────────────────────────────────────────────────────────

## Opens a connection through a driver.
##
## ### Parameters
## - `driver`: Target `Driver` (its `open_fn` hook runs).
## - `path`: Connection target string (file path, URL, `:memory:` ...).
##
## ### Returns
## An open `Conn` handle.
##
## ### Examples
## ```alya
## let conn = open(driver, ":memory:")
## ```
pub function open(driver: Driver, path: string) -> Conn
    let open_fn = driver.open_fn
    let handle = open_fn(path)
    return Conn { driver: driver, handle: handle, path: path, is_open: true, pool_id: 0 }
end

## Closes a connection; closing twice safely returns `0`.
##
## ### Parameters
## - `conn`: Target `Conn` handle.
##
## ### Returns
## Driver close result code integer.
pub function close(conn: Conn) -> int
    if conn.is_open != true
        return 0
    end
    let close_fn = conn.driver.close_fn
    let rc = close_fn(conn.handle)
    conn.is_open = false
    return rc
end

# ───────────────────────────────────────────────────────────────
# Query and Command Execution
# ───────────────────────────────────────────────────────────────

## Executes a statement with bound `?` parameters.
##
## ### Parameters
## - `conn`: Target `Conn` handle.
## - `sql`: SQL statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## Affected row count integer.
##
## ### Examples
## ```alya
## execute(conn, "INSERT INTO kv (k, v) VALUES (?, ?);", [param_text("a"), param_int(1)])
## ```
pub function execute(conn: Conn, sql: string, params: array = []) -> int
    if conn.is_open != true
        throw db_error(1, "Cannot execute on closed connection")
    end
    let execute_fn = conn.driver.execute_fn
    return execute_fn(conn.handle, sql, params)
end

## Runs a SELECT query with bound `?` parameters.
##
## Rows decode to column-name maps; value dynamics follow the driver
## (ints, floats, strings, nulls, byte arrays).
##
## ### Parameters
## - `conn`: Target `Conn` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## Array of row maps (possibly empty).
pub function query(conn: Conn, sql: string, params: array = []) -> array
    if conn.is_open != true
        throw db_error(1, "Cannot query on closed connection")
    end
    let query_fn = conn.driver.query_fn
    return query_fn(conn.handle, sql, params)
end

## Returns the first column of the first row, or null when no rows match.
##
## ### Parameters
## - `conn`: Target `Conn` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## The scalar value, or null for empty results.
pub function query_scalar(conn: Conn, sql: string, params: array = [])
    let rows = query(conn, sql, params)
    if len(rows) == 0
        return null
    end
    let first_row = rows[0]
    let ks = keys(first_row)
    for k in ks
        return first_row[k]
    end
    return null
end

## Begins a transaction (`BEGIN` through the driver).
##
## ### Parameters
## - `conn`: Target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function begin(conn: Conn) -> int
    return execute(conn, "BEGIN")
end

## Commits the current transaction (`COMMIT` through the driver).
##
## ### Parameters
## - `conn`: Target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function commit(conn: Conn) -> int
    return execute(conn, "COMMIT")
end

## Rolls back the current transaction (`ROLLBACK` through the driver).
##
## ### Parameters
## - `conn`: Target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function rollback(conn: Conn) -> int
    return execute(conn, "ROLLBACK")
end

# ───────────────────────────────────────────────────────────────
# Connection Struct Methods
# ───────────────────────────────────────────────────────────────

## Executes a statement with bound `?` parameters on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
## - `sql`: SQL statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## Affected row count integer.
pub function Conn.execute(self: Conn, sql: string, params: array = []) -> int
    return execute(self, sql, params)
end

## Runs a SELECT query with bound `?` parameters on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## Array of row maps (possibly empty).
pub function Conn.query(self: Conn, sql: string, params: array = []) -> array
    return query(self, sql, params)
end

## Returns the first column of the first row, or null when no rows match.
##
## ### Parameters
## - `self`: The target `Conn` handle.
## - `sql`: SELECT statement with `?` placeholders.
## - `params`: Array of `Param`, one per placeholder in order.
##
## ### Returns
## The scalar value, or null for empty results.
pub function Conn.query_scalar(self: Conn, sql: string, params: array = [])
    return query_scalar(self, sql, params)
end

## Begins a transaction on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function Conn.begin(self: Conn) -> int
    return begin(self)
end

## Commits the current transaction on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function Conn.commit(self: Conn) -> int
    return commit(self)
end

## Rolls back the current transaction on this connection.
##
## ### Parameters
## - `self`: The target `Conn` handle.
##
## ### Returns
## Affected row count integer.
pub function Conn.rollback(self: Conn) -> int
    return rollback(self)
end

## Closes this connection; closing twice safely returns `0`.
##
## ### Parameters
## - `self`: The target `Conn` handle.
##
## ### Returns
## Driver close result code integer.
pub function Conn.close(self: Conn) -> int
    return close(self)
end

# ───────────────────────────────────────────────────────────────
# Connection Pooling
# ───────────────────────────────────────────────────────────────

## Opens a bounded connection pool (lazy: connections open on acquire).
##
## ### Parameters
## - `driver`: Driver used for pooled connections.
## - `path`: Connection target string passed to `open_fn`.
## - `max_size`: Maximum live connections; must be positive.
##
## ### Returns
## An empty, open `ConnPool`.
##
## ### Examples
## ```alya
## let pool = pooled_open(driver, ":memory:", 10)
## ```
pub function pooled_open(driver: Driver, path: string, max_size: int = 10) -> ConnPool
    if max_size <= 0
        throw db_error(2, "Pool max_size must be positive")
    end
    return ConnPool { driver: driver, path: path, max_size: max_size, idle: [], active: [], next_id: 1, closed: false }
end

function pool_take_active(pool: ConnPool, id: int)
    let kept = []
    let found = null
    for c in pool.active
        if c.pool_id == id
            found = c
        else
            kept.push(c)
        end
    end
    pool.active = kept
    return found
end

## Borrows a connection: reuses an idle one or opens a new one below cap.
##
## Externally closed idle connections are skipped. Returns null when the
## pool is closed or exhausted.
##
## ### Parameters
## - `self`: The target `ConnPool`.
##
## ### Returns
## A `Conn` ready to use, or null.
pub function ConnPool.acquire(self: ConnPool)
    if self.closed == true
        return null
    end
    while len(self.idle) > 0
        let c = self.idle.pop()
        if c.is_open == true
            self.active.push(c)
            return c
        end
    end
    if len(self.active) + len(self.idle) >= self.max_size
        return null
    end
    let conn = open(self.driver, self.path)
    conn.pool_id = self.next_id
    self.next_id += 1
    self.active.push(conn)
    return conn
end

## Returns a borrowed connection to the idle pool.
##
## Externally closed connections are dropped instead of shelved.
##
## ### Parameters
## - `self`: The target `ConnPool`.
## - `conn`: The borrowed `Conn` to return.
##
## ### Returns
## `1` when shelved or dropped, `0` for null input.
pub function ConnPool.release(self: ConnPool, conn) -> int
    if conn is null
        return 0
    end
    pool_take_active(self, conn.pool_id)
    if conn.is_open == true
        self.idle.push(conn)
    end
    return 1
end

## Discards a broken connection: closes it and drops it from the pool.
##
## ### Parameters
## - `self`: The target `ConnPool`.
## - `conn`: The broken `Conn` to discard.
##
## ### Returns
## `1` when discarded, `0` for null input.
pub function ConnPool.invalidate(self: ConnPool, conn) -> int
    if conn is null
        return 0
    end
    pool_take_active(self, conn.pool_id)
    close(conn)
    return 1
end

## Closes all idle connections and shuts the pool down.
##
## Active loans are left to their holders (release or invalidate them).
##
## ### Parameters
## - `self`: The target `ConnPool`.
##
## ### Returns
## Number of idle connections drained.
pub function ConnPool.close(self: ConnPool) -> int
    let n = 0
    for c in self.idle
        close(c)
        n += 1
    end
    self.idle = []
    self.closed = true
    return n
end

## Returns the total live connection count (idle + active).
##
## ### Parameters
## - `self`: The target `ConnPool`.
##
## ### Returns
## Live connection count integer.
pub function ConnPool.size(self: ConnPool) -> int
    return len(self.idle) + len(self.active)
end

## Returns the idle connection count.
##
## ### Parameters
## - `self`: The target `ConnPool`.
##
## ### Returns
## Idle connection count integer.
pub function ConnPool.idle_count(self: ConnPool) -> int
    return len(self.idle)
end

## Returns the borrowed connection count.
##
## ### Parameters
## - `self`: The target `ConnPool`.
##
## ### Returns
## Active connection count integer.
pub function ConnPool.active_count(self: ConnPool) -> int
    return len(self.active)
end
