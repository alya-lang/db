## Example usage and walkthrough for db
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## A minimal in-memory driver backs this demo. Real drivers (sqlite adapter
## next) implement the same four hooks; every facade call below works
## unchanged against them.

import "../src/lib.alya" as pkg

function demo_open(_path: string)
    return { "store": map(), "tx": 0, "journal": null }
end

function demo_close(_handle) -> int
    return 0
end

function demo_text_of(p) -> string
    let s: string = p.sval
    return s
end

function demo_float_text(p) -> string
    let f: float = p.fval
    return str(f)
end

function demo_value_of(p)
    when p.kind
        is pkg::ParamKind.Int, 1 then return p.ival
        is pkg::ParamKind.Float, 2 then return demo_float_text(p)
        is pkg::ParamKind.Text, 3 then return demo_text_of(p)
        is pkg::ParamKind.Null, 4 then return null
        is pkg::ParamKind.Blob, 5 then return p.bval
        else throw pkg::db_error(3, "demo: unknown param kind")
    end
end

function demo_snapshot(store)
    let snap = map()
    let ks = keys(store)
    for k in ks
        snap[k] = store[k]
    end
    return snap
end

function demo_execute(handle, sql: string, params: array) -> int
    if sql == "BEGIN"
        handle["tx"] = 1
        handle["journal"] = demo_snapshot(handle["store"])
        return 0
    end
    if sql == "COMMIT"
        handle["tx"] = 0
        handle["journal"] = null
        return 0
    end
    if sql == "ROLLBACK"
        handle["tx"] = 0
        if handle["journal"] is not null
            handle["store"] = handle["journal"]
            handle["journal"] = null
        end
        return 0
    end
    if len(params) == 2
        let store = handle["store"]
        let kp = params[0]
        if kp.kind == pkg::ParamKind.Text
            let ks: string = kp.sval
            store[ks] = demo_value_of(params[1])
            return 1
        end
    end
    throw pkg::db_error(3, "demo: unsupported statement")
end

function demo_query(handle, _sql: string, params: array) -> array
    if len(params) == 1
        let store = handle["store"]
        let kp = params[0]
        if kp.kind == pkg::ParamKind.Text
            let ks: string = kp.sval
            if ks in store
                return [{ "key": ks, "value": store[ks] }]
            end
            return []
        end
    end
    throw pkg::db_error(3, "demo: unsupported statement")
end

function demo_driver()
    return pkg::Driver { name: "demo-mem", open_fn: demo_open, close_fn: demo_close, execute_fn: demo_execute, query_fn: demo_query }
end

function main()
    say "==========================================="
    say "          DB PACKAGE SHOWCASE              "
    say "==========================================="

    # 1. Open through a driver value (no registry, no globals)
    let conn = pkg::open(demo_driver(), ":memory:")
    say "1. Connected with driver 'demo-mem'"

    # 2. Parameterized writes (quotes need no escaping)
    pkg::execute(conn, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("name"), pkg::param_text("O'Brien")])
    pkg::execute(conn, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("visits"), pkg::param_int(41)])
    say "2. Inserted 2 rows with bound params"

    # 3. Reads: query, scalar, missing key
    let rows = pkg::query(conn, "SELECT k, v FROM kv WHERE k = ?;", [pkg::param_text("name")])
    say "3. Read back: " + str(rows[0]["value"])
    let visits = pkg::query_scalar(conn, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("visits")])
    say "   Visits: " + str(visits)
    # Inline null check: kept as a compatible guard from the
    # alya-lang/alya#170 era (let-bound dynamic nulls demoted then).
    if pkg::query_scalar(conn, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("nope")]) is null
        say "   Missing key reads null"
    end

    # 4. Transactions through the same facade
    pkg::begin(conn)
    pkg::execute(conn, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("tmp"), pkg::param_int(1)])
    pkg::rollback(conn)
    say "4. Rolled back; tmp rows: " + str(len(pkg::query(conn, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("tmp")])))

    # 5. Structured errors are catchable structs
    try
        pkg::execute(conn, "VACUUM;", [])
    catch err
        say "5. Caught DbError code " + str(err.code) + ": " + err.message
    end

    # 6. Method-call forms + close
    conn.execute("INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("m"), pkg::param_int(7)])
    say "6. Method insert ok; closing returns " + str(conn.close())

    # 7. Pooled connections (explicit driver + path, no closures needed)
    let pool = pkg::pooled_open(demo_driver(), ":memory:", 2)
    let pc = pool.acquire()
    pc.execute("INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("pooled"), pkg::param_int(1)])
    pool.release(pc)
    say "7. Pool size: " + str(pool.size()) + ", idle: " + str(pool.idle_count())
    let pc2 = pool.acquire()
    say "   Reused id: " + str(pc2.pool_id)
    pool.release(pc2)
    say "   Drained: " + str(pool.close())
    say "==========================================="
end

main()
