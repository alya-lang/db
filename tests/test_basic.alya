## Test suite for db
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

# ───────────────────────────────────────────────────────────────
# Mock driver: in-memory key-value store implementing the Driver
# contract. Future driver authors (postgres, mysql, ...): mirror this
# shape — open/close/execute/query hooks plus `Param` dispatch — and your
# driver plugs into every facade call below with no changes to `db`.
# Handle shape: { "store": map, "tx": int, "journal": map or null,
# "closed": int }. Snapshots are shallow (values are never mutated).
# ───────────────────────────────────────────────────────────────

function mock_open(_path: string)
    return { "store": map(), "tx": 0, "journal": null, "closed": 0 }
end

function mock_require_open(handle)
    if handle["closed"] == true
        throw pkg::db_error(1, "mock: connection is closed")
    end
end

function mock_count_placeholders(sql: string) -> int
    let n = 0
    let i = 0
    while i < len(sql)
        if char_at(sql, i) == "?"
            n += 1
        end
        i += 1
    end
    return n
end

function mock_check_params(sql: string, params: array)
    if mock_count_placeholders(sql) != len(params)
        throw pkg::db_error(2, "mock: parameter count mismatch")
    end
end

function mock_text_of(p) -> string
    let s: string = p.sval
    return s
end

# Floats store as round-trip text: map slots cannot retain float tags
# (unboxed bits are indistinguishable from ints on read), so native
# doubles would come back as int bit patterns. Same rule as real drivers.
function mock_float_text(p) -> string
    let s: string = p.sval
    return s
end

function mock_value_of(p)
    when p.kind
        is pkg::ParamKind.Int, 1 then return p.ival
        is pkg::ParamKind.Float, 2 then return mock_float_text(p)
        is pkg::ParamKind.Text, 3 then return mock_text_of(p)
        is pkg::ParamKind.Null, 4 then return null
        is pkg::ParamKind.Blob, 5 then return p.bval
        else throw pkg::db_error(3, "mock: unknown param kind")
    end
end

function mock_snapshot(store)
    let snap = map()
    let ks = keys(store)
    for k in ks
        snap[k] = store[k]
    end
    return snap
end

function mock_close(handle) -> int
    if handle["closed"] == true
        return 0
    end
    handle["closed"] = 1
    return 0
end

function mock_execute(handle, sql: string, params: array) -> int
    mock_require_open(handle)
    mock_check_params(sql, params)
    if sql == "BEGIN"
        handle["tx"] = 1
        handle["journal"] = mock_snapshot(handle["store"])
        return 0
    end
    if sql == "COMMIT"
        handle["tx"] = 0
        handle["journal"] = null
        return 0
    end
    if sql == "ROLLBACK"
        handle["tx"] = 0
        if handle["journal"] is not null
            handle["store"] = handle["journal"]
            handle["journal"] = null
        end
        return 0
    end
    # INSERT INTO kv ... with params [text key, value]
    if len(params) == 2
        let key_param = params[0]
        if key_param.kind == pkg::ParamKind.Text
            let store = handle["store"]
            let ks: string = key_param.sval
            store[ks] = mock_value_of(params[1])
            return 1
        end
        throw pkg::db_error(3, "mock: INSERT key param must be text")
    end
    throw pkg::db_error(3, "mock: unsupported statement")
end

function mock_query(handle, sql: string, params: array) -> array
    mock_require_open(handle)
    mock_check_params(sql, params)
    # SELECT ... WHERE key = ? with params [text key]
    if len(params) == 1
        let key_param = params[0]
        if key_param.kind == pkg::ParamKind.Text
            let store = handle["store"]
            let ks: string = key_param.sval
            if store[ks] is not null or ks in store
                return [{ "key": ks, "value": store[ks] }]
            end
            return []
        end
        throw pkg::db_error(3, "mock: SELECT key param must be text")
    end
    throw pkg::db_error(3, "mock: unsupported statement")
end

function make_mock_driver()
    return pkg::Driver { name: "mock", open_fn: mock_open, close_fn: mock_close, execute_fn: mock_execute, query_fn: mock_query }
end

function main()
    test_suite("db Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Param constructors & kinds
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::ParamKind.Int, 1, "ParamKind.Int == 1")
    runner_assert_eq(r, pkg::ParamKind.Float, 2, "ParamKind.Float == 2")
    runner_assert_eq(r, pkg::ParamKind.Text, 3, "ParamKind.Text == 3")
    runner_assert_eq(r, pkg::ParamKind.Null, 4, "ParamKind.Null == 4")
    runner_assert_eq(r, pkg::ParamKind.Blob, 5, "ParamKind.Blob == 5")

    let pi = pkg::param_int(42)
    runner_assert_eq(r, pi.kind, 1, "param_int kind is Int")
    runner_assert_eq(r, pi.ival, 42, "param_int carries value")
    let pf = pkg::param_float(19.99)
    runner_assert_eq(r, pf.kind, 2, "param_float kind is Float")
    let pt = pkg::param_text("O'Brien")
    runner_assert_eq(r, pt.kind, 3, "param_text kind is Text")
    runner_assert_str_eq(r, pt.sval, "O'Brien", "param_text carries quotes safely")
    let pn = pkg::param_null()
    runner_assert_eq(r, pn.kind, 4, "param_null kind is Null")
    let pb = pkg::param_blob([1, 2, 255])
    runner_assert_eq(r, pb.kind, 5, "param_blob kind is Blob")
    runner_assert_eq(r, len(pb.bval), 3, "param_blob carries bytes")

    # ═══════════════════════════════════════════════════════════
    # 2. DbError shape
    # ═══════════════════════════════════════════════════════════
    let de = pkg::db_error(7, "boom")
    runner_assert_eq(r, de.code, 7, "db_error carries code")
    runner_assert_str_eq(r, de.message, "boom", "db_error carries message")

    # ═══════════════════════════════════════════════════════════
    # 3. Driver construction & lifecycle
    # ═══════════════════════════════════════════════════════════
    let driver = make_mock_driver()
    runner_assert_str_eq(r, driver.name, "mock", "driver name is mock")

    let conn = pkg::open(driver, ":memory:")
    runner_assert_true(r, conn.is_open, "connection starts open")
    runner_assert_str_eq(r, conn.path, ":memory:", "connection keeps path")
    runner_assert_eq(r, pkg::close(conn), 0, "close returns 0")
    runner_assert_eq(r, pkg::close(conn), 0, "double close safely returns 0")

    # ═══════════════════════════════════════════════════════════
    # 4. Text roundtrip through the abstraction
    # ═══════════════════════════════════════════════════════════
    let c2 = pkg::open(driver, ":memory:")
    let n1 = pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("name"), pkg::param_text("O'Brien")])
    runner_assert_eq(r, n1, 1, "execute insert affects 1 row")
    let rows = pkg::query(c2, "SELECT k, v FROM kv WHERE k = ?;", [pkg::param_text("name")])
    runner_assert_eq(r, len(rows), 1, "query returns 1 row")
    runner_assert_str_eq(r, rows[0]["value"], "O'Brien", "quoted text roundtrips")

    # ═══════════════════════════════════════════════════════════
    # 5. All five param kinds end to end (floats via str(), never ==)
    # ═══════════════════════════════════════════════════════════
    pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("n"), pkg::param_int(42)])
    pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("f"), pkg::param_float(19.99)])
    pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("b"), pkg::param_blob([1, 2, 3, 255])])
    pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("z"), pkg::param_null()])
    pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("big"), pkg::param_int(1099511627776)])
    let rn = pkg::query(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("n")])
    runner_assert_eq(r, rn[0]["value"], 42, "int param roundtrips")
    # Floats roundtrip through the construction-cached text rendering
    # (same rule as real drivers: native floats do not survive travel).
    let rf = pkg::query(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("f")])
    runner_assert_str_eq(r, str(rf[0]["value"]), "19.99", "float param roundtrips")
    let rb = pkg::query(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("b")])
    runner_assert_eq(r, len(rb[0]["value"]), 4, "blob has 4 bytes")
    runner_assert_eq(r, rb[0]["value"][3], 255, "blob last byte is 255")
    let rz = pkg::query(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("z")])
    runner_assert_true(r, rz[0]["value"] is null, "null param stays null")
    let rbig = pkg::query(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("big")])
    runner_assert_eq(r, rbig[0]["value"], 1099511627776, "int64 param roundtrips")

    # ═══════════════════════════════════════════════════════════
    # 6. Scalar queries (present + missing)
    # ═══════════════════════════════════════════════════════════
    let sc = pkg::query_scalar(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("n")])
    runner_assert_eq(r, sc, 42, "query_scalar returns value")
    # Inline null check: null from an untyped return loses its tag when
    # let-bound (compiler follow-up to alya-lang/alya#168).
    runner_assert_true(r, pkg::query_scalar(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("nope")]) is null, "query_scalar on missing returns null")

    # ═══════════════════════════════════════════════════════════
    # 7. Structured errors (mismatch, unsupported, closed)
    # ═══════════════════════════════════════════════════════════
    let mismatch = 0
    try
        pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [])
    catch err
        mismatch = err.code
    end
    runner_assert_eq(r, mismatch, 2, "parameter mismatch throws code 2")

    let unsup = ""
    try
        pkg::execute(c2, "VACUUM;", [])
    catch err
        unsup = err.message
    end
    runner_assert_true(r, len(unsup) > 0, "unsupported statement throws message")

    let c3 = pkg::open(driver, ":memory:")
    pkg::close(c3)
    let closed_code = 0
    try
        pkg::execute(c3, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("x"), pkg::param_int(1)])
    catch err
        closed_code = err.code
    end
    runner_assert_eq(r, closed_code, 1, "execute on closed throws code 1")
    let closed_q = 0
    try
        pkg::query(c3, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("x")])
    catch err
        closed_q = err.code
    end
    runner_assert_eq(r, closed_q, 1, "query on closed throws code 1")

    # ═══════════════════════════════════════════════════════════
    # 8. Transactions with real rollback (journaled mock)
    # ═══════════════════════════════════════════════════════════
    pkg::begin(c2)
    pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("tmp"), pkg::param_int(1)])
    pkg::rollback(c2)
    let after_rb = pkg::query(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("tmp")])
    runner_assert_eq(r, len(after_rb), 0, "rollback undoes insert")
    pkg::begin(c2)
    pkg::execute(c2, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("kept"), pkg::param_int(2)])
    pkg::commit(c2)
    let after_commit = pkg::query(c2, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("kept")])
    runner_assert_eq(r, len(after_commit), 1, "commit persists insert")

    # ═══════════════════════════════════════════════════════════
    # 9. Connection method forms
    # ═══════════════════════════════════════════════════════════
    let c4 = pkg::open(driver, ":memory:")
    runner_assert_eq(r, c4.execute("INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("m"), pkg::param_int(7)]), 1, "Conn.execute affects 1 row")
    runner_assert_eq(r, len(c4.query("SELECT v FROM kv WHERE k = ?;", [pkg::param_text("m")])), 1, "Conn.query returns 1 row")
    runner_assert_eq(r, c4.query_scalar("SELECT v FROM kv WHERE k = ?;", [pkg::param_text("m")]), 7, "Conn.query_scalar returns value")
    c4.begin()
    c4.execute("INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("m2"), pkg::param_int(8)])
    c4.rollback()
    runner_assert_eq(r, len(c4.query("SELECT v FROM kv WHERE k = ?;", [pkg::param_text("m2")])), 0, "Conn.rollback undoes insert")
    runner_assert_eq(r, c4.close(), 0, "Conn.close returns 0")
    pkg::close(c2)

    # ═══════════════════════════════════════════════════════════
    # 10. Connection pool (mock driver, explicit context)
    # ═══════════════════════════════════════════════════════════
    test_pool(r)

    # ═══════════════════════════════════════════════════════════
    # 11. SQLite adapter (`sqlite` feature, default-on)
    # ═══════════════════════════════════════════════════════════
    test_sqlite_adapter(r)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

function test_pool(r)
    let driver = make_mock_driver()
    let bad_size = 0
    try
        pkg::pooled_open(driver, ":memory:", 0)
    catch err
        bad_size = err.code
    end
    runner_assert_eq(r, bad_size, 2, "pooled_open rejects non-positive max_size")

    let pool = pkg::pooled_open(driver, ":memory:", 2)
    runner_assert_eq(r, pool.size(), 0, "pool starts empty")
    runner_assert_eq(r, pool.max_size, 2, "pool keeps max_size")

    let a = pool.acquire()
    runner_assert_true(r, a is not null, "acquire opens a connection")
    runner_assert_eq(r, pool.size(), 1, "pool size is 1 after acquire")
    runner_assert_eq(r, pool.active_count(), 1, "active count is 1")
    runner_assert_eq(r, pool.idle_count(), 0, "idle count is 0")
    pkg::execute(a, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("p"), pkg::param_int(9)])
    runner_assert_eq(r, pool.release(a), 1, "release returns 1")
    runner_assert_eq(r, pool.idle_count(), 1, "idle count is 1 after release")
    runner_assert_eq(r, pool.active_count(), 0, "active count is 0 after release")

    let b = pool.acquire()
    runner_assert_eq(r, b.pool_id, a.pool_id, "acquire reuses idle connection")
    runner_assert_eq(r, pool.release(b), 1, "release reused connection")

    let p1 = pkg::pooled_open(driver, ":memory:", 1)
    let x1 = p1.acquire()
    runner_assert_true(r, x1 is not null, "single-slot acquire succeeds")
    runner_assert_true(r, p1.acquire() is null, "exhausted acquire returns null")
    runner_assert_eq(r, p1.release(x1), 1, "release into single-slot pool")
    p1.close()

    let c = pool.acquire()
    runner_assert_eq(r, pool.invalidate(c), 1, "invalidate returns 1")
    runner_assert_eq(r, pool.size(), 0, "pool size is 0 after invalidate")
    runner_assert_true(r, pkg::conn_is_open(c) == false, "invalidated connection is closed")

    let d = pool.acquire()
    d.close()
    runner_assert_eq(r, pool.release(d), 1, "release externally closed returns 1")
    runner_assert_eq(r, pool.idle_count(), 0, "externally closed connection is dropped")
    runner_assert_eq(r, pool.size(), 0, "pool size is 0 after drop")

    let e1 = pool.acquire()
    let e2 = pool.acquire()
    runner_assert_eq(r, pool.active_count(), 2, "two concurrent loans")
    runner_assert_eq(r, pool.release(e1), 1, "release first loan")
    runner_assert_eq(r, pool.release(e2), 1, "release second loan")
    runner_assert_eq(r, pool.close(), 2, "pool close drains 2 idle")
    runner_assert_eq(r, pool.size(), 0, "pool size is 0 after close")
    runner_assert_true(r, pool.acquire() is null, "acquire on closed pool returns null")
    runner_assert_eq(r, pool.close(), 0, "double pool close drains 0")
end

@cfg(feature = "sqlite")
function test_sqlite_adapter(r)
    let driver = pkg::sqlite_driver()
    runner_assert_str_eq(r, driver.name, "sqlite", "adapter driver name is sqlite")

    let conn = pkg::open(driver, ":memory:")
    pkg::execute(conn, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, score REAL, payload BLOB, note TEXT);")
    let n = pkg::execute(conn, "INSERT INTO users (name, score, payload, note) VALUES (?, ?, ?, ?);", [pkg::param_text("O'Brien"), pkg::param_float(19.99), pkg::param_blob([9, 8, 7]), pkg::param_null()])
    runner_assert_eq(r, n, 1, "adapter insert affects 1 row")

    let rows = pkg::query(conn, "SELECT name, score, payload, note FROM users WHERE name = ?;", [pkg::param_text("O'Brien")])
    runner_assert_eq(r, len(rows), 1, "adapter query returns 1 row")
    runner_assert_str_eq(r, rows[0]["name"], "O'Brien", "adapter text roundtrips")
    runner_assert_str_eq(r, str(rows[0]["score"]), "19.99", "adapter float roundtrips via str()")
    runner_assert_true(r, rows[0]["note"] is null, "adapter null stays null")
    runner_assert_eq(r, len(rows[0]["payload"]), 3, "adapter blob roundtrips")
    runner_assert_eq(r, pkg::query_scalar(conn, "SELECT count(*) FROM users;"), 1, "adapter scalar counts 1")

    pkg::execute(conn, "CREATE TABLE bigints (val INTEGER);")
    let big = 1099511627776
    pkg::execute(conn, "INSERT INTO bigints (val) VALUES (?);", [pkg::param_int(big)])
    let bigrows = pkg::query(conn, "SELECT val FROM bigints WHERE val = ?;", [pkg::param_int(big)])
    runner_assert_eq(r, len(bigrows), 1, "adapter int64 row found")
    runner_assert_eq(r, bigrows[0]["val"], big, "adapter int64 roundtrips")

    pkg::begin(conn)
    pkg::execute(conn, "INSERT INTO users (name) VALUES (?);", [pkg::param_text("tmp")])
    pkg::rollback(conn)
    runner_assert_eq(r, pkg::query_scalar(conn, "SELECT count(*) FROM users;"), 1, "adapter rollback undoes insert")

    let badcode = 0
    try
        pkg::execute(conn, "SELECT * FROM no_such_table;", [])
    catch err
        badcode = err.code
    end
    runner_assert_eq(r, badcode, 1, "adapter engine error arrives as DbError code 1")
    runner_assert_eq(r, conn.close(), 0, "adapter Conn.close returns 0")
end

@cfg(not(feature = "sqlite"))
function test_sqlite_adapter(r)
end

main()
