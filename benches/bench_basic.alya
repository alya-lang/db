## Benchmark suite for db
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

# Minimal stub driver: canned answers, no state. Measures facade and
# dispatch overhead, not driver work.
function stub_open(_path: string)
    return 0
end

function stub_close(_handle) -> int
    return 0
end

function stub_execute(_handle, _sql: string, _params: array) -> int
    return 1
end

function stub_query(_handle, _sql: string, _params: array) -> array
    return []
end

function stub_driver()
    return pkg::Driver { name: "stub", open_fn: stub_open, close_fn: stub_close, execute_fn: stub_execute, query_fn: stub_query }
end

function main()
    let runner = bench_runner("db Micro-Benchmarks")
    let driver = stub_driver()

    # Bench 1: open/close cycle — 20k iterations
    bench_start(runner, 20000)
    let i = 0
    while i < 20000
        let conn = pkg::open(driver, ":memory:")
        pkg::close(conn)
        i += 1
    end
    bench_stop(runner, "open/close 20k cycles")

    # Bench 2: execute with params — 20k iterations
    let conn = pkg::open(driver, ":memory:")
    bench_start(runner, 20000)
    let j = 0
    while j < 20000
        pkg::execute(conn, "INSERT INTO kv (k, v) VALUES (?, ?);", [pkg::param_text("k"), pkg::param_int(j)])
        j += 1
    end
    bench_stop(runner, "execute with params 20k calls")

    # Bench 3: query_scalar (miss path) — 20k iterations
    bench_start(runner, 20000)
    let k = 0
    while k < 20000
        pkg::query_scalar(conn, "SELECT v FROM kv WHERE k = ?;", [pkg::param_text("k")])
        k += 1
    end
    bench_stop(runner, "query_scalar 20k calls")
    pkg::close(conn)

    # Bench 4: param constructors — 100k iterations
    bench_start(runner, 100000)
    let m = 0
    while m < 100000
        pkg::param_text("bench")
        m += 1
    end
    bench_stop(runner, "param_text 100k calls")

    bench_summary(runner)
end

main()
